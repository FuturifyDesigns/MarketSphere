# Copy to android/key.properties (gitignored) and fill in before Play Store release.
# Generate a keystore once, e.g.:
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# storePassword=...
# keyPassword=...
# keyAlias=upload
# storeFile=../upload-keystore.jks
