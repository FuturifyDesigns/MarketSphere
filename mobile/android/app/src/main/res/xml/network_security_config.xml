<?xml version="1.0" encoding="utf-8"?>
<!-- Deny cleartext; TLS only for all domains (Supabase + site CDN). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
