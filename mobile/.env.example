# Copy to mobile/.env for local debug builds (gitignored).
# For release, prefer:
#   flutter build apk --release --dart-define-from-file=mobile/.env
# so keys are not required as a Flutter asset (anon key remains public by design).

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
